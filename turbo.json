{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json", ".env"],

  // Turbo 2 runs tasks in STRICT env mode by default: a task sees only the
  // variables declared here (plus Turbo's own passthrough list), not the full
  // environment. Undeclared variables are not an error — they are silently
  // absent, so code that reads one gets `undefined` and takes whatever branch
  // that implies.
  //
  // That is how the tenancy integration suite came to report `9 skipped` in CI
  // while the workflow set both URLs three lines above the step that ran it:
  // the suite skips when no database is CONFIGURED, and inside turbo none was.
  // Declaring them here is what makes the tests CI actually runs match the
  // tests CI appears to run.
  // RUN_S3_INTEGRATION and the S3_* pair are here for the same reason as the
  // database URLs: the MinIO round-trip skips itself when unconfigured, so an
  // undeclared variable turns `RUN_S3_INTEGRATION=1 pnpm test` into a green run
  // that quietly tested nothing.
  "globalEnv": [
    "DATABASE_URL",
    "DIRECT_URL",
    "REDIS_URL",
    "TZ",
    "NODE_ENV",
    "CI",
    "RUN_S3_INTEGRATION",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY_ID",
    "S3_SECRET_ACCESS_KEY",
    "S3_FORCE_PATH_STYLE",
    "S3_BUCKET_DOCUMENTS"
  ],

  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:eval": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "e2e:smoke": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
