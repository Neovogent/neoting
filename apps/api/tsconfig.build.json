{
  // Emit config, separate from tsconfig.json because that one is `noEmit`
  // (it exists to typecheck tests as well as sources, and tests must never
  // reach dist/).
  //
  // WHY A tsc EMIT WORKS HERE AT ALL, given moduleResolution: "Bundler":
  //
  // It used to work only because every `@neoting/contracts` import in this app
  // was `import type` and erased at emit, leaving the compiled output with no
  // runtime dependency on a package Node could not load. This comment used to
  // end by predicting the day a VALUE would be imported, and prescribing the
  // fix: give contracts a real build output and point its exports map at the
  // JS, rather than reaching for a bundler.
  //
  // That happened — issue #88, needed by the ingestion and documents
  // controllers, which parse their boundaries with the generated Zod schemas.
  // `packages/contracts` now emits ESM whose relative specifiers all carry
  // `.js`, so Node resolves them, and value imports from contracts are
  // ordinary. The prediction is kept here rather than deleted because it is
  // the reasoning that still holds: `tsc` copies specifiers through verbatim,
  // so an extensionless import anywhere in the graph is a runtime failure with
  // a clean build — which is why contracts guards that mechanically
  // (check-contract.mjs assertion 7, and its `test` script).
  //
  // Consequence: contracts must be BUILT before this app is built. Turbo knows;
  // the Dockerfile is told explicitly because it uses `pnpm --filter`.
  //
  // Relative imports already carry explicit `.js` extensions throughout src/,
  // which is what makes the emitted ESM runnable by Node directly.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",

    // Nothing consumes this app as a library; declarations are dead weight in
    // a container image and slow the build.
    "declaration": false,
    "declarationMap": false,

    // Kept: a stack trace from a staging task should point at a .ts line.
    "sourceMap": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", ".turbo", "src/**/*.test.ts", "src/**/*.integration.test.ts"]
}
