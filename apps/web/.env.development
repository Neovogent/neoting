# Dev-mode defaults (METH Stage 6): `pnpm dev` talks to the real API.
#
# Vite loads this file in dev mode ONLY — vitest runs in mode `test` and
# `pnpm build` in mode `production`, so tests and built bundles stay synthetic
# unless told otherwise. Opt out per-machine with a gitignored
# `.env.development.local` setting VITE_API_ENABLED=false.
#
# The API side must run AUTH_MODE=session (repo .env) for the login wall to
# answer; under AUTH_MODE=fixture the /me probe fails and the app degrades to
# synthetic data with a dev badge rather than showing a wall nobody can pass.
VITE_API_ENABLED=true

# Empty ON PURPOSE: requests go same-origin (`/v1/...`) and the Vite dev proxy
# (vite.config.ts) forwards them to :3000 — first-party cookie, no CORS.
VITE_API_BASE_URL=
