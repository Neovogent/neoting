{
  "name": "@neoting/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src && pnpm run i18n:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:extract": "formatjs extract 'src/**/*.{ts,tsx}' --ignore='**/*.test.*' --out-file lang/en-GB.json --id-interpolation-pattern '[sha512:contenthash:base64:6]'",
    "i18n:check": "node ./scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@neoting/contracts": "workspace:^",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-intl": "^7.1.11",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@formatjs/cli": "^6.7.2",
    "@tailwindcss/vite": "^4.1.14",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^10.8.1",
    "eslint-plugin-formatjs": "^5.4.0",
    "jsdom": "^25.0.1",
    "msw": "^2.4.9",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.6",
    "vite": "^6.2.3",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
