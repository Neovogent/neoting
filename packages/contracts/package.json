{
  "name": "@neoting/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http-client": {
      "types": "./dist/http-client.d.ts",
      "default": "./dist/http-client.js"
    },
    "./client": {
      "types": "./dist/generated/client/index.d.ts",
      "default": "./dist/generated/client/index.js"
    },
    "./model": {
      "types": "./dist/generated/model/index.d.ts",
      "default": "./dist/generated/model/index.js"
    },
    "./zod": {
      "types": "./dist/generated/zod/index.d.ts",
      "default": "./dist/generated/zod/index.js"
    }
  },
  "scripts": {
    "generate": "orval --config ./orval.config.ts && node ./scripts/enforce-money-int.mjs && node ./scripts/strip-zod-describe.mjs && node ./scripts/add-js-extensions.mjs && node ./scripts/check-contract.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.build.json",
    "check:contract": "node ./scripts/check-contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/check-contract.mjs",
    "test": "node ./scripts/verify-runtime-import.mjs"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=8",
    "@tanstack/react-query": ">=5",
    "msw": ">=2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@tanstack/react-query": "^5.59.0",
    "@types/node": "^22.7.4",
    "js-yaml": "^4.1.0",
    "msw": "^2.4.9",
    "orval": "^7.1.1",
    "typescript": "^5.6.2"
  }
}
