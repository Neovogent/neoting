{
  "name": "@neoting/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./http-client": "./src/http-client.ts",
    "./client": "./src/generated/client/index.ts",
    "./model": "./src/generated/model/index.ts",
    "./zod": "./src/generated/zod/index.ts"
  },
  "scripts": {
    "generate": "orval --config ./orval.config.ts && node ./scripts/enforce-money-int.mjs && node ./scripts/check-contract.mjs",
    "build": "pnpm run generate",
    "check:contract": "node ./scripts/check-contract.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node ./scripts/check-contract.mjs",
    "test": "echo \"test: contract assertions run in lint (scripts/check-contract.mjs)\""
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@faker-js/faker": ">=8",
    "@tanstack/react-query": ">=5",
    "msw": ">=2"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "msw": {
      "optional": true
    },
    "@faker-js/faker": {
      "optional": true
    }
  },
  "devDependencies": {
    "@faker-js/faker": "^9.0.3",
    "@tanstack/react-query": "^5.59.0",
    "@types/node": "^22.7.4",
    "js-yaml": "^4.1.0",
    "msw": "^2.4.9",
    "orval": "^7.1.1",
    "typescript": "^5.6.2"
  }
}
