// APPROVALS & THE REVIEW → APPROVE SPINE
// ===========================================================================

model ApprovalWorkflow {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  name        String
  /// Stages including conditional branches (SoT Stage 9).
  stages      Json
  appliesTo   Json?    @map("applies_to")
  specificity Int      @default(0)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  business  Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  approvals Approval[]

  @@index([businessId, isActive])
  @@map("approval_workflows")
}

model Approval {
  id         String  @id @default(cuid())
  workflowId String? @map("workflow_id")
  documentId String  @map("document_id")

  stageIndex  Int      @map("stage_index")
  actorUserId String   @map("actor_user_id")
  decision    String
  comment     String?
  decidedAt   DateTime @default(now()) @map("decided_at")

  workflow ApprovalWorkflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  document Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User              @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([documentId])
  @@map("approvals")
}

enum ProposalState {
  CREATED
  REVIEWED
  APPROVED
  EXECUTED
  CANCELLED
  EXPIRED
}

/// THE REVIEW → APPROVE SPINE (Governance §10).
///
/// Every state-changing action begins here. `kind` must exist in the
/// action-kind registry. `reviewedAt` is set only by the server endpoint behind
/// [Read review], and Approve is accepted ONLY if it is set, within TTL, by an
/// actor holding the permission for that kind. Models can create proposals;
/// only a human UI action can approve one.
///
/// payloadHash and renderedSummaryHash together prove that what was approved is
/// what was shown.
model ActionProposal {
  id         String  @id @default(cuid())
  businessId String? @map("business_id")

  /// Tenancy anchor, same discipline as `Document` (issue #104). AT LEAST ONE
  /// of `practiceId`/`businessId` is present, enforced by the CHECK constraint
  /// `action_proposals_tenant_anchor`. Before this column existed, a proposal
  /// with `business_id = NULL` satisfied the RLS policy unconditionally — a
  /// world-readable, world-writable row — and NULL business is the DEFAULT for
  /// `document.route`, whose subject is an unrouted document. The policy now
  /// reads the same two-branch predicate documents use.
  practiceId String? @map("practice_id")

  kind                String
  payload             Json
  payloadHash         String  @map("payload_hash")
  renderedSummary     Json?   @map("rendered_summary")
  renderedSummaryHash String? @map("rendered_summary_hash")

  state            ProposalState @default(CREATED)
  createdByUserId  String?       @map("created_by_user_id")
  createdByModel   String?       @map("created_by_model")
  createdAt        DateTime      @default(now()) @map("created_at")
  reviewedAt       DateTime?     @map("reviewed_at")
  approvedByUserId String?       @map("approved_by_user_id")
  approvedAt       DateTime?     @map("approved_at")
  executedAt       DateTime?     @map("executed_at")
  expiresAt        DateTime      @map("expires_at")

  /// Standing automations execute without a per-item proposal only under a
  /// policy that was itself approved through this contract. Executions record
  /// which policy they ran under.
  policyProposalId String? @map("policy_proposal_id")

  outcome Json?
  traceId String? @map("trace_id")

  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  practice   Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  createdBy  User?     @relation("ProposalCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy User?     @relation("ProposalApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId, state])
  @@index([practiceId, state])
  @@index([kind, state])
  @@index([traceId])
  @@map("action_proposals")
}

// ===========================================================================
// PUBLISHING
// ===========================================================================

/// ⚠ VT and MANUAL exist because without them NOTHING CAN EVER REACH PUBLISHED.
///
/// `publish-batch.ts` resolves an Integration before it will admit a document
/// for publish, and `resolveIntegration` is the only door: with no active row
/// it refuses with "this client has no active ledger connection". Under D42
/// there IS no ledger connection to make — no adapter, no OAuth flow, no
/// endpoint — and D47 says client intake must not ask for one. So every
/// document stopped at READY forever and the export had nothing to export.
///
/// VT     — the client's own VT Transaction+ installation. Nothing is
///          transmitted to it; the row records which target this business
///          exports for, so the emitter and the accountant agree.
/// MANUAL — no target named. Export produces the generic CSV.
///
/// Neither carries a token, an org ref or a health state, and neither may ever
/// become an adapter call: D42 makes *Published* an INTERNAL state meaning
/// approved and released for export, asserting nothing about a ledger.
enum IntegrationKind {
  XERO
  QUICKBOOKS
  SAGE
  FREEAGENT
  VT
  MANUAL
}

model Integration {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  kind             IntegrationKind
  orgRef           String?         @map("org_ref")
  tokenRef         String?         @map("token_ref")
  tokenExpiresAt   DateTime?       @map("token_expires_at")
  health           String?
  lastSyncAt       DateTime?       @map("last_sync_at")
  lastErrorAt      DateTime?       @map("last_error_at")
  lastErrorMessage String?         @map("last_error_message")
  isActive         Boolean         @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  referenceSyncs ReferenceSync[]
  publishes      Publish[]

  @@unique([businessId, kind])
  @@index([businessId, isActive])
  @@map("integrations")
}

/// Two-way sync of reference lists so category dropdowns always show the
/// client's real chart of accounts (SoT Stage 10).
model ReferenceSync {
  id            String @id @default(cuid())
  integrationId String @map("integration_id")

  listKind String   @map("list_kind")
  payload  Json
  syncedAt DateTime @default(now()) @map("synced_at")

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, listKind])
  @@map("reference_syncs")
}

enum PublishMode {
  MANUAL
  AUTO
  AI
}

enum PublishState {
  QUEUED
  SUCCEEDED
  FAILED
}

model Publish {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  documentId    String  @map("document_id")
  integrationId String? @map("integration_id")

  mode           PublishMode
  state          PublishState @default(QUEUED)
  externalRef    String?      @map("external_ref")
  /// Mandatory. Republishing must never create a duplicate vendor or
  /// double-post a bill (SoT §17.1).
  idempotencyKey String       @map("idempotency_key")
  attachmentSent Boolean      @default(false) @map("attachment_sent")

  actionProposalId  String? @map("action_proposal_id")
  failureCode       String? @map("failure_code")
  failureMessage    String? @map("failure_message")
  publishedByUserId String? @map("published_by_user_id")

  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  document    Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  integration Integration? @relation(fields: [integrationId], references: [id], onDelete: SetNull)

  @@unique([idempotencyKey])
  @@index([businessId, state])
  @@index([documentId])
  @@map("publishes")
}

// ===========================================================================
// CROSS-CUTTING
// ===========================================================================

model VaultItem {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  s3Key            String    @map("s3_key")
  filename         String
  mimeType         String    @map("mime_type")
  byteSize         Int       @map("byte_size")
  title            String?
  summary          String?
  category         String?
  tags             String[]  @default([])
  folderPath       String?   @map("folder_path")
  keyDates         Json?     @map("key_dates")
  expiresAt        DateTime? @map("expires_at")
  uploadedByUserId String?   @map("uploaded_by_user_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, category])
  @@index([businessId, expiresAt])
  @@map("vault_items")
}

model Task {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  title           String
  description     String?
  ownerUserId     String?   @map("owner_user_id")
  dueAt           DateTime? @map("due_at")
  status          String    @default("open")
  cadence         String?
  dependsOnTaskId String?   @map("depends_on_task_id")
  /// The AI marks a task done when the underlying engine has actually run
  /// (SoT §7) — never on its own say-so.
  aiPrefilledAt   DateTime? @map("ai_prefilled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, status])
  @@map("tasks")
}

model Notification {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  event           String
  recipientUserId String?   @map("recipient_user_id")
  channels        String[]  @default([])
  payload         Json?
  readAt          DateTime? @map("read_at")
  sentAt          DateTime? @map("sent_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, recipientUserId, readAt])
  @@map("notifications")
}

model SmsLog {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  toE164            String   @map("to_e164")
  body              String
  providerMessageId String?  @map("provider_message_id")
  deliveryState     String?  @map("delivery_state")
  costPence         Int?     @map("cost_pence")
  chaseId           String?  @map("chase_id")
  sentAt            DateTime @default(now()) @map("sent_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, sentAt])
  @@map("sms_log")
}

model Import {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  kind            String
  filename        String?
  mappingRef      String?   @map("mapping_ref")
  rowCount        Int?      @map("row_count")
  state           String    @default("queued")
  failureMessage  String?   @map("failure_message")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@map("imports")
}

/// ⚠ This model already existed and is EXTENDED, not replaced. The ID plan
/// asked for "an Export model: id, businessId, target, rowCount, createdBy,
/// createdAt"; four of those six were already here under their own names
/// (`createdByUserId`), so a second model would have been a second door onto
/// the same resource with the same RLS policy. Only `target`, `rowCount` and
/// the period bounds are new.
///
/// Under D42 this table is the record of the ONLY way data leaves the product.
model Export {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  kind   String
  format String

  /// Which accounting package the file is shaped for. Nullable because rows
  /// written before this column existed have no answer, and expand-contract
  /// forbids inventing one (Governance §5.3).
  target ExportTarget?

  /// The period the export covers, recorded as columns rather than inside
  /// `filters` because "has this period already been exported for this client"
  /// is a question the export screen asks on every render, and a JSON predicate
  /// makes it a scan.
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  /// How many canonical rows the emitter wrote. The accountant reconciles this
  /// against what VT's Universal Input Sheet shows before pressing Post, so a
  /// silently short file is caught by a human at the one moment they are
  /// looking. Null on a failed or legacy export.
  rowCount Int? @map("row_count")

  filters         Json?
  s3Key           String?   @map("s3_key")
  state           String    @default("queued")
  virusScanned    Boolean   @default(false) @map("virus_scanned")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  completedAt     DateTime? @map("completed_at")
  expiresAt       DateTime? @map("expires_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, state])
  @@index([businessId, target, periodEnd])
  @@map("exports")
}

/// A short capability URL onto one document — the D43 source-document link.
///
/// **The token IS the authorisation.** `GET /d/{code}` is unauthenticated by
/// design: the whole point is that an accountant reads the code out of a CSV
/// column inside VT Transaction+, where no session of ours exists, and reaches
/// the document. SoT §24.3.2 makes the constraints binding — unguessable,
/// per-document, view-only, individually revocable, access-logged, expiry
/// configurable per practice (`practices.document_link_ttl_days`).
///
/// **Why the code is stored in plain text.** Every other token in this schema
/// is a hash (`Invite.tokenHash`, `OtpSession.linkTokenHash`,
/// `Session.refreshTokenHash`) because nothing ever needs to read it back. This
/// one is different: the same document re-exported next month must carry the
/// SAME code, or the accountant's saved VT conversion table stops matching and
/// every import goes manual again — §24.3.1 calls that byte-stability the
/// highest-leverage detail in the whole export. A hash cannot be re-emitted. So
/// the code is stored, and its safety comes from being unguessable and
/// rate-limited rather than from being secret at rest.
///
/// **Two shape constraints that come from VT, not from us**, and both are
/// enforced where the code is minted rather than here, because Postgres cannot
/// express "contains a letter" without a CHECK that would then have to be
/// carried by hand through every rebuild:
///   - it must contain at least one LETTER — VT has a documented history of
///     coercing numeric-looking strings in `Entry details` into 2-decimal
///     numbers, which would silently corrupt an all-digit code;
///   - the whole URL must stay short — target reference fields truncate
///     SILENTLY at 30 and ~25 characters, and a truncated link is worse than no
///     link because it looks correct and resolves to nothing.
///
/// **Not unique per document, deliberately.** Revocation must actually break
/// the links already sitting in someone's ledger, so revoking mints nothing and
/// a replacement is a new row. Byte-stability is "reuse the live link if there
/// is one", which is an application rule; a `@@unique([documentId])` here would
/// make revocation impossible instead.
model DocumentLink {
  id         String @id @default(cuid())
  documentId String @map("document_id")
  businessId String @map("business_id")

  /// Six to eight URL-safe characters from a CSPRNG (SoT §24.3.2 rung 2).
  code String @unique

  createdByUserId String? @map("created_by_user_id")

  /// NULL means no expiry — a practice that set `document_link_ttl_days` to
  /// nothing has chosen links that outlive the engagement.
  expiresAt DateTime? @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  /// The access log, denormalised. SoT §24.3.2 requires accesses to be logged;
  /// the narrative record is an `audit_events` row like every other access, and
  /// these two columns are the cheap projection the revoke screen renders — "12
  /// views, last one on Tuesday" is the whole question an accountant asks
  /// before revoking, and it should not cost an audit scan.
  accessCount    Int       @default(0) @map("access_count")
  lastAccessedAt DateTime? @map("last_accessed_at")

  createdAt DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  /// "The live link for this document", which is what the emitter asks for once
  /// per exported row.
  @@index([documentId, revokedAt])
  @@map("document_links")
}

/// The export targets ID actually emits. Deliberately two values, not five:
/// SoT §24.3 names VT (primary), Xero, Sage and generic CSV as the target set,
/// and A7 builds the VT emitter only. An enum value with no emitter behind it
/// is a 500 waiting for whoever passes it, so Xero and Sage arrive with their
/// emitters or not at all.
enum ExportTarget {
  VT_TRANSACTION_PLUS
  GENERIC_CSV
}

/// Stripe's own subscription statuses, upper-cased. All eight are here even
/// though ID's flow touches four, because the webhook writes whatever Stripe
/// sends and a value the enum does not admit is a failed write — loud, retried
/// by Stripe, and visible — rather than a silently stale entitlement.
enum SubscriptionStatus {
  INCOMPLETE
  INCOMPLETE_EXPIRED
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  PAUSED
}

/// Append-only and hash-chained. There is no update or delete API for this
/// table — writes go through one audit service only (Governance §12.3).
/// Actor references are pseudonymised; destroying a subject's pseudonym key
/// renders their trail anonymous while chain integrity survives (crypto-
/// shredding, the documented erasure mechanism for immutable logs).
model AuditEvent {
  id         String  @id @default(cuid())
  businessId String? @map("business_id")

  seq          BigInt
  previousHash String? @map("previous_hash")
  hash         String

  traceId             String? @map("trace_id")
  correlationId       String? @map("correlation_id")
  actorPseudonym      String? @map("actor_pseudonym")
  event               String
  inputHash           String? @map("input_hash")
  inputPointer        String? @map("input_pointer")
  modelId             String? @map("model_id")
  promptVersion       String? @map("prompt_version")
  proposalId          String? @map("proposal_id")
  payloadHash         String? @map("payload_hash")
  renderedSummaryHash String? @map("rendered_summary_hash")
  outcome             Json?
  latencyMs           Int?    @map("latency_ms")
  tokensIn            Int?    @map("tokens_in")
  tokensOut           Int?    @map("tokens_out")

  createdAt DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@unique([businessId, seq])
  @@index([businessId, createdAt])
  @@index([traceId])
  @@map("audit_events")
}

/// Bootstrap only: a local flags file behind the same interface as Unleash
/// (Guideline §8.5). Flipping to the real server at Infra Week must be config,
/// not code.
model FeatureFlag {
  id          String    @id @default(cuid())
  key         String    @unique
  isEnabled   Boolean   @default(false) @map("is_enabled")
  description String?
  owner       String?
  removeBy    DateTime? @map("remove_by")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("feature_flags")
}
