// NEOTING — database schema (Sprint-0 contract, LAW per G7/D15)
//
// Source of Truth §15 (data model), Governance §5 (Prisma rules, RLS).
//
// INVARIANTS THIS FILE ENCODES
//   1. Money is integer pence. Every monetary column is Int, named *Pence, and
//      there is no Decimal or Float anywhere in this file. Ceiling is
//      £21,474,836.47 per column — above SME range; revisit with BigInt if a
//      client ever needs more.
//   2. Every tenant-owned row carries businessId, and practiceId where the row
//      belongs to a practice-managed workspace. RLS policies (see
//      migrations/*_rls) read these through session GUCs. Adding a tenant table
//      without its policy is an incomplete migration.
//   3. Timestamps are UTC. Rendering in Europe/London happens at the edge.
//   4. Originals are immutable. Corrections are new rows, never overwrites.
//   5. Nothing changes state without an ActionProposal (Governance §10).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations and seeding run as the OWNER; the application runs as `nt_app`,
  // which is subject to RLS. Without this split the app connects as a superuser
  // and every policy in sql/rls.sql is inert (issue #17) — with it, `prisma
  // migrate` still works, because migrations legitimately need to cross every
  // tenant boundary and are the only thing that should.
  directUrl = env("DIRECT_URL")
}

// ===========================================================================
// IDENTITY & TENANCY
// ===========================================================================

model Practice {
  id                String   @id @default(cuid())
  name              String
  logoS3Key         String?  @map("logo_s3_key")
  countryCode       String   @default("GB") @map("country_code")
  baseCurrency      String   @default("GBP") @map("base_currency")
  language          String   @default("en-GB")
  registeredAddress Json?    @map("registered_address")
  vatNumber         String?  @map("vat_number")
  vatRegistered     Boolean  @default(false) @map("vat_registered")
  yearEndMonth      Int?     @map("year_end_month")
  yearEndDay        Int?     @map("year_end_day")

  /// How long a `/d/{code}` capability URL stays resolvable, in days. NULL
  /// means the platform default. D43 makes expiry "configurable per practice",
  /// and the setting lives here rather than in config because the practice
  /// whose links are pasted into a client's ledger is the one who has to
  /// choose between a link that dies and a link that outlives the engagement.
  documentLinkTtlDays Int? @map("document_link_ttl_days")

  /// The Meta phone_number_id of the WhatsApp Business number that RECEIVES
  /// this practice's client messages (#79's promised column — additive,
  /// 1 Sep 2026). Derived from the number that received the message, never
  /// from the sender. Unique because one Meta number delivers to exactly one
  /// practice; a number shared by two would make routing a coin toss. The
  /// WHATSAPP_PRACTICE_MAP env var remains as an override the controller can
  /// read without a DB round trip; the worker falls back to this column.
  whatsappPhoneNumberId String? @unique @map("whatsapp_phone_number_id")

  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  businesses  Business[]
  memberships Membership[]
  invites     Invite[]
  guidance    Guidance[]
  documents   Document[]
  proposals   ActionProposal[]
  otpSessions OtpSession[]

  @@map("practices")
}

/// A client workspace. Standalone businesses have practiceId = null — the same
/// pipeline, without the practice layer above them (SoT §3.2).
model Business {
  id         String  @id @default(cuid())
  practiceId String? @map("practice_id")

  name              String
  tradingName       String? @map("trading_name")
  logoS3Key         String? @map("logo_s3_key")
  companyNumber     String? @map("company_number")
  legalStructure    String? @map("legal_structure")
  industry          String?
  website           String?
  registeredAddress Json?   @map("registered_address")
  tradingAddress    Json?   @map("trading_address")
  countryCode       String  @default("GB") @map("country_code")
  baseCurrency      String  @default("GBP") @map("base_currency")

  vatRegistered  Boolean   @default(false) @map("vat_registered")
  vatNumber      String?   @map("vat_number")
  vatScheme      String?   @map("vat_scheme")
  vatFrequency   String?   @map("vat_frequency")
  vatPeriodStart DateTime? @map("vat_period_start")
  yearEndMonth   Int?      @map("year_end_month")
  yearEndDay     Int?      @map("year_end_day")

  /// Business-context questionnaire — feeds AI grounding and cold-start
  /// category inference (SoT §5.1, Stage 4).
  contextQuestionnaire Json? @map("context_questionnaire")

  bookkeepingManagedBy String?   @map("bookkeeping_managed_by")
  bookkeepingFrequency String?   @map("bookkeeping_frequency")
  nextDeadline         DateTime? @map("next_deadline")
  practiceCode         String?   @map("practice_code")

  isActive  Boolean  @default(true) @map("is_active")

  /// ---- Subscription (D48, ID only) ----------------------------------------
  ///
  /// Four columns rather than a `subscriptions` table, deliberately: ID sells
  /// ONE flat plan per client business (£8.50/month + VAT), so a business has
  /// at most one subscription and a child table would buy a join for nothing.
  /// Stripe owns the invoices, the dunning and the card; this is the local
  /// projection the product reads to answer "is this workspace entitled".
  ///
  /// ⚠ `stripeCustomerId` is UNIQUE on purpose. `POST /v1/webhooks/stripe`
  /// runs with NO session, so it cannot lean on RLS to find the tenant — it has
  /// to resolve one from the Stripe customer id and assert it matched exactly
  /// one row. The unique index is what makes that assertion structural rather
  /// than a hopeful `findFirst`: a subscription written to the wrong tenant
  /// would be invisible, because RLS fails closed and silent.
  stripeCustomerId             String?             @unique @map("stripe_customer_id")
  subscriptionStatus           SubscriptionStatus? @map("subscription_status")
  /// The Stripe price/plan reference this business is on. Free text, not an
  /// enum: it is Stripe's identifier, and pinning our own enum to a value only
  /// Stripe mints would make a dashboard change a schema change.
  plan                         String?
  subscriptionCurrentPeriodEnd DateTime?           @map("subscription_current_period_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  practice Practice? @relation(fields: [practiceId], references: [id], onDelete: Restrict)

  memberships        Membership[]
  contacts           Contact[]
  invites            Invite[]
  documents          Document[]
  rules              Rule[]
  guidance           Guidance[]
  bankConnections    BankConnection[]
  bankAccounts       BankAccount[]
  bankTransactions   BankTransaction[]
  statements         Statement[]
  supplierStatements SupplierStatement[]
  chases             Chase[]
  approvalWorkflows  ApprovalWorkflow[]
  actionProposals    ActionProposal[]
  integrations       Integration[]
  publishes          Publish[]
  vaultItems         VaultItem[]
  tasks              Task[]
  notifications      Notification[]
  smsLogs            SmsLog[]
  exports            Export[]
  imports            Import[]
  auditEvents        AuditEvent[]
  documentLinks      DocumentLink[]

  @@index([practiceId])
  @@index([practiceId, isActive])
  @@map("businesses")
}

/// HUMAN signs in; SYSTEM never does.
///
/// A queue worker has no human behind it, but every RLS policy requires
/// `app_actor_id() IS NOT NULL` — so machine writes need an actor or they
/// cannot happen at all. The alternative was a third `session_scope` with its
/// own policy branch on every tenant table, which is policy surface that has to
/// be remembered forever, on a LAW file, by everyone who ever adds a table.
///
/// A SYSTEM user with a practice-level membership goes through the *existing*
/// predicate instead: rls.sql does not change, and `audit_events.actor_id`
/// names a real row rather than a magic string, so "who did this" has one
/// answer shape whether a person or a worker did it. Contract change: #17.
///
/// SYSTEM users must be excluded from team lists, seat counts and invites. They
/// have no password, no email and no sessions, so they cannot sign in even if
/// one leaks into a UI.
enum UserKind {
  HUMAN
  SYSTEM
}

model User {
  id            String   @id @default(cuid())
  kind          UserKind @default(HUMAN)
  email         String?  @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  passwordHash  String?  @map("password_hash")
  firstName     String?  @map("first_name")
  lastName      String?  @map("last_name")

  totpSecretRef String?   @map("totp_secret_ref")
  totpEnabledAt DateTime? @map("totp_enabled_at")

  lastLoginAt   DateTime? @map("last_login_at")
  deactivatedAt DateTime? @map("deactivated_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  memberships       Membership[]
  sessions          Session[]
  otpSessions       OtpSession[]
  sentInvites       Invite[]         @relation("InviteSentBy")
  approvals         Approval[]
  actionProposals   ActionProposal[] @relation("ProposalCreatedBy")
  approvedProposals ActionProposal[] @relation("ProposalApprovedBy")
  ownedDocuments    Document[]       @relation("DocumentOwner")

  @@map("users")
}

enum WorkspaceRole {
  PRACTICE_ADMIN
  CLIENT_ADMIN
  PRACTICE_STANDARD
  BUSINESS_ADMIN
  USER_ADMIN
  BUSINESS_STANDARD
}

/// Roles are always set per account (SoT §3.3). Fine-grained permissions are
/// checked at call sites, never roles — assertCan(actor, action, resource).
model Membership {
  id         String  @id @default(cuid())
  userId     String  @map("user_id")
  practiceId String? @map("practice_id")
  businessId String? @map("business_id")

  role        WorkspaceRole
  permissions String[]      @default([])

  /// Non-finance submitters see their submission, not the coding (SoT §3.3).
  hideFinancialFields Boolean @default(false) @map("hide_financial_fields")
  isOwner             Boolean @default(false) @map("is_owner")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  practice Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@index([practiceId])
  /// These two exist because `app_can_access_business()` runs an EXISTS against
  /// memberships FOR EVERY ROW of every policed query — they are what make it an
  /// index probe instead of a scan (rls.sql §7).
  ///
  /// They are declared here, with `map:` pinning the names rls.sql uses, because
  /// otherwise Prisma does not know they exist: `migrate diff` sees two indexes
  /// in the database and none in the schema, and helpfully emits DROP INDEX for
  /// both. That drop is silent, reversible only by noticing, and its symptom is
  /// the whole product getting slower under load rather than anything failing.
  @@index([userId, businessId], map: "memberships_user_business_idx")
  @@index([userId, practiceId], map: "memberships_user_practice_idx")
  @@map("memberships")
}

/// Client-side people who may exist as a verified mobile number and nothing
/// else. They receive chases and upload through OTP links without ever being
/// provisioned as users (SoT §3.3).
model Contact {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  userId           String?   @map("user_id")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  role             String?
  mobileE164       String?   @map("mobile_e164")
  mobileVerifiedAt DateTime? @map("mobile_verified_at")
  email            String?
  isPrimary        Boolean   @default(false) @map("is_primary")
  receivesChases   Boolean   @default(true) @map("receives_chases")
  whatsappOptIn    Boolean   @default(false) @map("whatsapp_opt_in")

  /// ---- The business's own people (D45, 2 Sep 2026) -------------------------
  ///
  /// A client business manages its own staff from its own portal — invite, give
  /// a role, control what they can do, remove. These four columns are what that
  /// needs, and they live HERE rather than on `memberships` for one hard reason:
  /// a `Membership` requires a `users` row, `users.email` is globally UNIQUE, and
  /// a portal person is an address with no password. Minting a shadow user per
  /// contact would collide the first time one person worked for two clients.
  /// `contacts` is already the row D45's sender map keys on, so one person on one
  /// workspace stays one row.
  ///
  /// ⚠ `role` above is FREE TEXT and stays that way — it is the job title, and a
  /// site's Foreman must not be flattened into "Staff". `portalRole` is the
  /// AUTHORITY, and it is the enum the schema already had.
  ///
  /// **Nullable, with NO backfill, and the derivation is the reason.** The
  /// effective authority is `portalRole ?? (isPrimary ? BUSINESS_ADMIN :
  /// BUSINESS_STANDARD)` — written once, in
  /// `modules/portal/portal-people-authority.ts`. Intake writes exactly one
  /// primary contact per business, so every workspace that already exists has
  /// exactly one owner the moment this column ships, and a migration that writes
  /// no data is one that cannot damage a database holding real client records.
  /// A `@default(BUSINESS_STANDARD)` would have been the opposite: every existing
  /// business with nobody able to manage anyone.
  portalRole WorkspaceRole? @map("portal_role")

  /// May upload for this business. Default true because every contact that
  /// predates this column already could (D45), and a column that silently
  /// removed a permission on deploy would be a regression wearing a migration.
  canSendDocuments Boolean @default(true) @map("can_send_documents")

  /// May see amounts. *"Staff photographing receipts should not see the
  /// company's figures."* Default true for the same reason as above — nothing
  /// hides totals from an existing contact today, so the column starts by
  /// describing what is already true and new invitations choose explicitly.
  canSeeTotals Boolean @default(true) @map("can_see_totals")

  /// Revoked, not deleted. Removing a person must not orphan or rewrite the
  /// provenance of documents they already sent, so this is a soft flag that
  /// three readers honour: the sender map (D45), the portal sign-in lookup, and
  /// the session resolver — which re-reads it on every request, so a live bearer
  /// dies with the revocation rather than lasting out its hour.
  deactivatedAt DateTime? @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  otpSessions OtpSession[]
  chases      Chase[]

  @@index([businessId])
  @@index([mobileE164])
  /// The People list and the sender map both read "this business's LIVE
  /// contacts", so the flag ships in the same migration as the query pattern
  /// that needs it (Governance §5.3).
  @@index([businessId, deactivatedAt])
  @@map("contacts")
}

model Invite {
  id         String  @id @default(cuid())
  practiceId String? @map("practice_id")
  businessId String? @map("business_id")

  email      String?
  mobileE164 String?       @map("mobile_e164")
  role       WorkspaceRole
  tokenHash  String        @unique @map("token_hash")
  expiresAt  DateTime      @map("expires_at")
  acceptedAt DateTime?     @map("accepted_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  /// Carried from the invitation onto the membership acceptance creates
  /// (SoT §3.3). It has to live here rather than being asked for again at
  /// acceptance: the person deciding a colleague is a non-finance submitter is
  /// the admin who invited them, not the colleague.
  ///
  /// ⚠ The column is WRITTEN and nothing in this release READS it when serving
  /// a document. `POST /businesses/{id}/members` already accepted the field and
  /// silently discarded it, which is worse — an accepted setting that governs
  /// nothing. Storing it is the honest half; the redaction is owed.
  hideFinancialFields Boolean @default(false) @map("hide_financial_fields")

  /// The clients an invited PRACTICE_STANDARD is scoped to, carried from the
  /// invitation to the memberships acceptance creates — one BUSINESS-SCOPED
  /// membership per id, which is where RLS starts confining them.
  ///
  /// **An array column rather than N invitation rows**, because the invitation
  /// is one decision reached by one email carrying one token, and `token_hash`
  /// is `@unique`: N rows would need N tokens or a shared one, and a shared one
  /// makes "spend this invitation" ambiguous. **Empty means practice-wide** —
  /// every client — which is also what a CLIENT_ADMIN always gets.
  ///
  /// No foreign key: Postgres has no FK on an array element, and the ids are
  /// re-checked against RLS at acceptance anyway, so a client offboarded between
  /// the invitation and its acceptance is simply not granted.
  businessIds String[] @default([]) @map("business_ids")

  /// Who sent it. Nullable because invitations predating this column have no
  /// answer, and `SetNull` because an inviter who leaves must not take the
  /// outstanding invitations with them — the invitation is the practice's, not
  /// theirs. Read only to name them on the acceptance screen.
  invitedByUserId String? @map("invited_by_user_id")

  practice  Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)
  business  Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InviteSentBy", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  @@index([businessId])
  /// The practice team list filters `practice_id` with `business_id IS NULL`,
  /// and `invites_tenant`'s practice branch compares `practice_id` on every row
  /// it policies. Neither had an index; `@@index([businessId])` covers only the
  /// client-invite half.
  ///
  /// ⚠ Deliberately NOT `@@unique([practiceId, email])`. `team.service.ts`
  /// documents a create-if-absent pattern that assumes re-inviting the same
  /// address is legal, and it is: an invitation that was never opened must be
  /// re-sendable without an admin first having to find and delete the old row.
  @@index([practiceId])
  @@map("invites")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceLabel      String?   @map("device_label")
  ipHash           String?   @map("ip_hash")
  userAgentHash    String?   @map("user_agent_hash")
  createdAt        DateTime  @default(now()) @map("created_at")
  lastUsedAt       DateTime  @default(now()) @map("last_used_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

enum OtpSessionScope {
  ONBOARDING
  DELEGATED_UPLOAD
  ITEM_MESSAGE
}

/// Portal sessions. A delegated session is scoped to exactly the item IDs it
/// was granted and nothing else — enforced by RLS, not by the handler
/// (Governance §5.2). The link is deliberately forwardable, so the audit trail
/// records requested-from separately from uploaded-by (SoT Stage 8.3).
model OtpSession {
  id String @id @default(cuid())

  /// Tenancy anchor, the same two-column shape as `documents` and
  /// `action_proposals`. AT LEAST ONE is present, enforced by the CHECK
  /// constraint `otp_sessions_tenant_anchor` — not exactly one, and the normal
  /// DELEGATED_UPLOAD case sets both.
  ///
  /// `business_id` became nullable for ONBOARDING (D47, SoT §24.5): a client
  /// signing in to complete their own setup, or an accountant-level code, has a
  /// practice above it and no business yet — under the old NOT NULL column that
  /// row had nowhere to live, which is why `OtpSessionScope.ONBOARDING` was
  /// declared and never used.
  ///
  /// ⚠ The nullable column is why this table left the `direct_tables` loop in
  /// rls.sql. `app_can_access_business(NULL)` is FALSE, so a NULL-business row
  /// under the old single-column policy would have been invisible and
  /// unwritable to everyone — the exact mirror of the #104 bug, which made a
  /// NULL-business proposal visible to everyone. Both are the same mistake: a
  /// nullable anchor under a policy written for a NOT NULL one. It now uses the
  /// anchor-pair predicate `app_can_access_document(business_id, practice_id)`.
  businessId String? @map("business_id")
  practiceId String? @map("practice_id")

  contactId      String?         @map("contact_id")
  userId         String?         @map("user_id")
  scope          OtpSessionScope
  grantedItemIds String[]        @default([]) @map("granted_item_ids")
  chaseId        String?         @map("chase_id")

  requestedFromContactId String? @map("requested_from_contact_id")

  otpHash      String?   @map("otp_hash")
  otpExpiresAt DateTime? @map("otp_expires_at")
  attempts     Int       @default(0)
  lockedUntil  DateTime? @map("locked_until")
  verifiedAt   DateTime? @map("verified_at")

  linkTokenHash String   @unique @map("link_token_hash")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")

  contact  Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  chase    Chase?    @relation(fields: [chaseId], references: [id], onDelete: SetNull)
  practice Practice? @relation(fields: [practiceId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([chaseId])
  /// The practice branch of the anchor-pair predicate reads `practice_id`, and
  /// an ONBOARDING row is found by it alone. Ships with the query pattern it
  /// exists for (Governance §5.3, expand-contract).
  @@index([practiceId])
  @@map("otp_sessions")
}

// ===========================================================================
// DOCUMENTS
// ===========================================================================

enum DocumentChannel {
  WEB_UPLOAD
  EMAIL
  WHATSAPP
  SMS_PORTAL
  CHAT_UPLOAD
  STRUCTURED_IMPORT
  API
}

enum Inbox {
  COSTS
  SALES
  UNROUTED
}

enum DocumentState {
  RECEIVED
  PROCESSING
  TO_REVIEW
  READY
  PUBLISHED
  ARCHIVED
  REJECTED
  FAILED
}

enum DocumentType {
  INVOICE
  RECEIPT
  CREDIT_NOTE
  STATEMENT
  OTHER
}

model Document {
  id String @id @default(cuid())

  /// Tenancy anchor. AT LEAST ONE of these is guaranteed present, enforced by a
  /// CHECK constraint (`documents_tenant_anchor`) rather than by convention.
  /// NOT exactly one — the shipped SQL is `practice_id IS NOT NULL OR
  /// business_id IS NOT NULL`, and both-set is the NORMAL routed case: web
  /// upload anchors the document on the business AND the business's own
  /// practice (#76), and the practice branch of `app_can_access_document`
  /// plus `@@index([practiceId, inbox])` read `practice_id` on routed rows.
  /// This comment said "EXACTLY ONE" until #81's review caught it — a test
  /// that leans on the constraint as an exactly-one oracle passes three
  /// states it thinks it excludes.
  ///
  /// `inbox` defaults to UNROUTED, which is the honest statement that we do not
  /// yet know whose document this is — a receipt forwarded to doc@ by a sender
  /// we do not recognise has no business until routing says so. A NOT NULL
  /// `business_id` would make that state unwritable, so ingestion would have to
  /// invent a placeholder tenant or drop the document, and this module's first
  /// invariant is that nothing is ever silently dropped.
  ///
  /// So an unrouted document is anchored one level up, on the practice that
  /// received it (the inbound address identifies which). `business_id` is
  /// filled in when routing resolves, and never cleared afterwards.
  ///
  /// `practice_id` is nullable rather than NOT NULL because a standalone
  /// business has no practice above it (see `Business.practiceId`). Such a
  /// business receives at its own address, so `business_id` is known from the
  /// first byte and the practice branch is never needed — but a NOT NULL
  /// `practice_id` would make its documents unwritable instead, which is the
  /// same bug moved rather than fixed.
  ///
  /// The RLS policy carries both branches, the shape `invites` and `guidance`
  /// already use in rls.sql. Contract change: issue #17.
  practiceId String? @map("practice_id")
  businessId String? @map("business_id")

  s3Key            String  @map("s3_key")
  originalFilename String  @map("original_filename")
  mimeType         String  @map("mime_type")
  byteSize         Int     @map("byte_size")
  byteHash         String  @map("byte_hash")
  perceptualHash   String? @map("perceptual_hash")

  channel         DocumentChannel
  submitterUserId String?         @map("submitter_user_id")
  submitterLabel  String?         @map("submitter_label")
  receivedAt      DateTime        @default(now()) @map("received_at")
  receivedLocal   String?         @map("received_local")

  /// Which rule or model routed this here, and how sure it was. Null when the
  /// sender identity matched exactly and no inference was needed.
  routingDecision   Json?  @map("routing_decision")
  routingConfidence Float? @map("routing_confidence")

  inbox   Inbox         @default(UNROUTED)
  state   DocumentState @default(RECEIVED)
  docType DocumentType? @map("doc_type")

  /// Populated from the accepted extraction so lists and search do not have to
  /// reach into extraction JSON. Money is pence.
  supplierName String?   @map("supplier_name")
  customerName String?   @map("customer_name")
  documentDate DateTime? @map("document_date")
  dueDate      DateTime? @map("due_date")
  currency     String?
  totalPence   Int?      @map("total_pence")
  taxPence     Int?      @map("tax_pence")
  reference    String?
  categoryCode String?   @map("category_code")
  description  String?
  projectRef   String?   @map("project_ref")

  /// Why it was rejected or failed — never null when state is REJECTED/FAILED.
  /// The Rejected/Failed view is a first-class surface (SoT Stage 5).
  failureCode    String? @map("failure_code")
  failureMessage String? @map("failure_message")

  parentDocumentId String? @map("parent_document_id")
  pageRange        String? @map("page_range")

  archivedAt DateTime? @map("archived_at")

  /// Trash. NULL means not deleted, and that is the DEFAULT LISTING PREDICATE
  /// everywhere — `common/documents/deleted-documents.ts` is the one place it is
  /// spelled, the `PORTAL_HIDDEN_DOCUMENT_STATE` shape, so a list filter and a
  /// count cannot drift apart.
  ///
  /// ⚠ **Deliberately NOT a ninth `DocumentState` member.** "Deleted" is
  /// orthogonal to where a document sits in the pipeline: a READY document that
  /// is deleted and restored is READY again, and `state` is what remembers
  /// that — a state member would have to destroy the answer in order to record
  /// the question. It would also be a compile break in every total mapping over
  /// `DocumentState` (`portal-document-status.ts`, `LEGAL_TRANSITIONS`) and a
  /// new word in the CLIENT-facing status vocabulary, which is the one place it
  /// must never appear. Same shape and same reasoning as `archivedAt`.
  ///
  /// Reversible by `POST /v1/documents/{id}/restoration`. Permanent removal is
  /// a `document.purge` proposal, which REFUSES a PUBLISHED document or one
  /// that appears in any export (D43 — every exported line must resolve back to
  /// its source).
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  practice Practice?  @relation(fields: [practiceId], references: [id], onDelete: Restrict)
  business Business?  @relation(fields: [businessId], references: [id], onDelete: Restrict)
  owner    User?      @relation("DocumentOwner", fields: [submitterUserId], references: [id], onDelete: SetNull)
  parent   Document?  @relation("DocumentSplit", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  children Document[] @relation("DocumentSplit")

  extractions   Extraction[]
  events        DocumentEvent[]
  suggestions   Suggestion[]
  duplicatesAsA Duplicate[]     @relation("DuplicateA")
  duplicatesAsB Duplicate[]     @relation("DuplicateB")
  matches       Match[]
  publishes     Publish[]
  itemThreads   ItemThread[]
  approvals     Approval[]
  links         DocumentLink[]

  @@index([businessId, inbox, state])
  @@index([businessId, receivedAt])
  @@index([businessId, byteHash])
  @@index([businessId, supplierName, documentDate])
  @@index([parentDocumentId])
  /// Trash: `WHERE business_id = ? AND deleted_at IS NOT NULL`. Every index
  /// above leads with a pipeline column after `business_id`, so none of them can
  /// serve it. Ships with the query pattern it exists for (expand-contract).
  @@index([businessId, deletedAt])
  /// The Unrouted queue: "everything this practice has received that nobody has
  /// routed yet". Every existing index above leads with business_id, which is
  /// precisely NULL for the rows this query wants, so none of them can serve it.
  /// Ships with the query pattern it exists for (Governance, expand-contract).
  @@index([practiceId, inbox])
  @@map("documents")
}

/// Every extraction records the model and prompt version that produced it, so
/// any historical decision is reproducible (Governance §9.8).
model Extraction {
  id         String @id @default(cuid())
  documentId String @map("document_id")

  /// Per-field: value, confidence, provenance (which pixels / rule / model).
  fields Json

  extractorKind     String  @map("extractor_kind")
  modelVersion      String? @map("model_version")
  promptVersion     String? @map("prompt_version")
  ladderRung        String? @map("ladder_rung")
  overallConfidence Float?  @map("overall_confidence")

  /// Deterministic validator results (packages/validators). Failures push the
  /// document to To Review regardless of model confidence.
  validatorResults Json? @map("validator_results")

  isAccepted    Boolean  @default(false) @map("is_accepted")
  keyedByUserId String?  @map("keyed_by_user_id")
  createdAt     DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("extractions")
}

/// The per-document processing log — every stage, tool, duration and outcome,
/// so any file's journey can be replayed end to end (Governance §13.4).
model DocumentEvent {
  id         String @id @default(cuid())
  documentId String @map("document_id")

  stage      String
  outcome    String
  durationMs Int?     @map("duration_ms")
  traceId    String?  @map("trace_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@index([traceId])
  @@map("document_events")
}

enum DuplicateVerdict {
  PENDING
  CONFIRMED_DUPLICATE
  CONFIRMED_DIFFERENT
  KEEP_BOTH
}

model Duplicate {
  id         String @id @default(cuid())
  businessId String @map("business_id")

  documentAId String @map("document_aid")
  documentBId String @map("document_bid")

  /// Which nets fired: byteHash, pHash, ocrSimilarity, fieldRule, crossType.
  signals Json
  score   Float

  verdict         DuplicateVerdict @default(PENDING)
  decidedByUserId String?          @map("decided_by_user_id")
  decidedAt       DateTime?        @map("decided_at")
  createdAt       DateTime         @default(now()) @map("created_at")

  documentA Document @relation("DuplicateA", fields: [documentAId], references: [id], onDelete: Cascade)
  documentB Document @relation("DuplicateB", fields: [documentBId], references: [id], onDelete: Cascade)

  @@unique([documentAId, documentBId])
  @@index([businessId, verdict])
  @@map("duplicates")
}

