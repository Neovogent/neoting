{
  "name": "neoting",
  "version": "0.0.0",
  "private": true,
  "description": "Neoting — chat-first document-to-bookkeeping platform. See docs/Source_Of_Truth.md",
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:eval": "turbo run test:eval",
    "e2e:smoke": "turbo run e2e:smoke",
    "db:migrate": "pnpm --filter @neoting/api exec prisma migrate dev",
    "db:seed": "pnpm --filter @neoting/api exec prisma db seed",
    "db:reset": "pnpm --filter @neoting/api exec prisma migrate reset --force",
    "db:tenancy-check": "docker exec -i nt-postgres psql -U neoting -d neoting -v ON_ERROR_STOP=1 -q < prisma/sql/tenancy-check.sql",
    "prepare": "husky"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "husky": "^9.1.6",
    "prisma": "^5.22.0",
    "tsx": "^4.19.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": ">=4.18.0",
      "js-yaml@<4.3.1": ">=4.3.1"
    }
  }
}
