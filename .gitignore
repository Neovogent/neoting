# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Generated from the OpenAPI contract (Governance §1.4: never commit generated
# output). Produced by `pnpm --filter @neoting/contracts generate`, which the
# build graph runs for you. The contract is openapi.yaml; this tree is its
# shadow, and a hand-patched type here is R3.
packages/contracts/src/generated/

# Environment — .env.example is the only one that ships (Guideline R2)
.env
.env.*
!.env.example

# Test and coverage output
coverage/
playwright-report/
test-results/
blob-report/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local scratch — anything here is yours and nobody else's
.scratch/
apps/web/web-errors.txt

# Extracted from source by `pnpm --filter @neoting/web i18n:extract` (Governance
# §1.4: never commit generated output). It is the artefact a translator
# receives, and `pnpm lint` regenerates and validates it on every run.
apps/web/lang/
