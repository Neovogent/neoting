# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Generated from the OpenAPI contract (Governance §1.4: never commit generated
# output). Produced by `pnpm --filter @neoting/contracts generate`, which the
# build graph runs for you. The contract is openapi.yaml; this tree is its
# shadow, and a hand-patched type here is R3.
packages/contracts/src/generated/

# Environment — .env.example is the only one that ships (Guideline R2)
.env
.env.*
!.env.example

# Test and coverage output
coverage/
playwright-report/
test-results/
blob-report/

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Local scratch — anything here is yours and nobody else's
.scratch/

# Model-generated synthetic test documents (docs/testing/gpt-test-document-prompts.md
# §10: gitignored because the set contains images)
fixtures/synthetic/
apps/web/web-errors.txt

# Extracted from source by `pnpm --filter @neoting/web i18n:extract` (Governance
# §1.4: never commit generated output). It is the artefact a translator
# receives, and `pnpm lint` regenerates and validates it on every run.
apps/web/lang/

# Claude Code working state: session scratch, agent worktrees, local settings.
# `.claude/worktrees/` held full checkouts, and a `git add -A` swept 17 of them into
# main as gitlinks with no .gitmodules (b5c0b11) — a fresh clone got empty directories
# and errors. Ignored so it cannot happen again.
.claude/

# Local agent/session scratch — never committed. SESSION_TASKS.md has held a
# working demo credential, and the npm caches are debug logs from a tool this
# repo does not use (pnpm only). AGENTS.md is NOT here: it is a tracked file
# since #249.
.npm-cache/
**/.npm-cache/
.dev-logs/
SESSION_TASKS.md
