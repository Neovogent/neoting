# Copy to .env — never commit .env (Guideline R2, Governance §11.5).
# The app validates this file with Zod at boot and fails fast on anything
# missing or malformed. No process.env access outside that module.
#
# Every value here points at Docker Compose. Nothing in this file is a real
# credential, and nothing in it should ever become one — production secrets
# live in AWS Secrets Manager.

NODE_ENV=development
TZ=Europe/London

# --- App --------------------------------------------------------------------
# The API binds here. 3000 is pinned by infra/envs/staging (ALB target group +
# app security group open exactly 3000); do not change it without the infra.
PORT=3000

# --- Core services (docker compose up) -------------------------------------
# TWO URLS, AND THE SPLIT IS THE TENANCY GUARANTEE (Governance §5.2, issue #17).
#
# Postgres bypasses row-level security for a superuser and for the owner of a
# table. `neoting` is both. So an application connected as `neoting` sees every
# row of every practice with every policy in prisma/sql/rls.sql still in place
# and still looking correct — the isolation is simply not applied. That is not a
# theoretical risk: it was the state of this repo until 14 Aug 2026, and it means
# a tenancy bug cannot fail on your machine, only in front of a client.
#
#   DATABASE_URL  -> nt_app  : the application. Not owner, not superuser, no
#                              BYPASSRLS, so the policies actually bite.
#   DIRECT_URL    -> neoting : prisma migrate and db:seed ONLY. These legitimately
#                              need to write across every tenant, and they are the
#                              only things that ever should.
#
# Create the role once after `docker compose up`: `pnpm db:app-role`.
DATABASE_URL=postgresql://nt_app:nt_app_local@localhost:5433/neoting?schema=public
DIRECT_URL=postgresql://neoting:neoting@localhost:5433/neoting?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 (MinIO locally) -----------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=neoting
S3_SECRET_ACCESS_KEY=neoting123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=nt-local-docs
S3_BUCKET_RECEIPTS=nt-local-receipts
S3_BUCKET_EXPORTS=nt-local-exports

# --- Email (MailHog locally) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=doc@neoting.neovogent.com
# Inbound email intake source (#78). fixture = in-memory (default, offline);
# mailhog = poll the local SES stand-in's HTTP API; s3 = the SES receipt prefix
# in staging. Run the poller with: pnpm --filter @neoting/api worker:email
EMAIL_SOURCE=fixture
MAILHOG_API_URL=http://localhost:8025

# --- Auth -------------------------------------------------------------------
# Local-only values. Generate real ones with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
OTP_PEPPER=dev-only-change-me-1111111111111111111111111111111111111111111111
# fixture = trust X-NT-* dev headers (default; refused in production).
# session = real signed-cookie sessions (METH Stage 1) — needs SESSION_SECRET.
AUTH_MODE=fixture
# demo = the one fixed six-digit code, on every account in every practice.
# totp = the real RFC 6238 verifier (A2). `demo` is REFUSED under
# NODE_ENV=production — see the superRefine block in apps/api/src/config/env.ts.
OTP_MODE=demo

# --- AI (Governance §9.1) ---------------------------------------------------
# fixture  = replay recorded extractions, zero cloud calls. The default, so a
#            fresh clone works offline and lanes stay green if access lags.
# bedrock  = real Bedrock calls, needs AWS creds in the environment.
AI_MODE=fixture
AWS_REGION=eu-west-2
BEDROCK_MODEL_JUDGMENT=anthropic.claude-opus-4-6-v1
BEDROCK_MODEL_WORKHORSE=anthropic.claude-sonnet-4-6
BEDROCK_MODEL_MECHANICAL=amazon.nova-lite-v1:0

# --- Extraction -------------------------------------------------------------
# ⚠ EXTRACTION_MODE was here and `config/env.ts` never read it. The real key is
# EXTRACTOR (demo | bedrock), declared with the rest of the adapter switches.

# --- Bank statement OCR (D20, D41) ------------------------------------------
# none | textract — how a PDF or photographed statement becomes a table.
#
# CSV and XLSX are exact grids and are read deterministically, so they import
# with this at `none`. A PDF or an image is then REFUSED with a reason, never
# silently skipped: a statement we did not read must never look like one that
# had no transactions.
#
# ⚠ `none` is the local default because Textract's multi-page path reads from
# S3 and CANNOT read MinIO. Testing a PDF statement locally needs a real bucket.
STATEMENT_READER=none

# --- Outbound email (S2) ----------------------------------------------------
# demo = DemoEmailSender "sends" into an in-memory outbox — no network, no AWS
# credentials, so a fresh clone runs the whole journey offline. Read it back in
# process with the sender's readOutbox()/lastTo(); locally that outbox is where
# you find the sign-in code you need in order to sign in.
# ⚠ `demo` REFUSES TO BOOT under NODE_ENV=production. It is the one stand-in
# whose failure is invisible: every send returns a message id and no email
# exists, and with SMS cut email is the client's only channel.
EMAIL_SENDER=demo
SES_REGION=eu-west-2
# ⚠ no-reply@, NEVER doc@ — doc@ is the INBOUND document intake address, and
# mail arriving there is filed as a client document. Sending from it would
# ingest every reply as paperwork.
EMAIL_FROM_ADDRESS=no-reply@neoting.neovogent.com
EMAIL_REPLY_TO_ADDRESS=support@neovogent.com
# `nt-<env>-default` in a deployed environment; empty on a laptop, where there
# is no configuration set. EMAIL_SENDER=ses REQUIRES it — without it a send
# silently opts out of bounce suppression and reputation metrics.
EMAIL_CONFIGURATION_SET=
# memory = in-process counters, correct for one process and only for one.
# `redis` is required alongside a real sender in production, where more than one
# task runs and a per-process ceiling is the ceiling multiplied by the task count.
EMAIL_RATE_LIMIT=memory

# --- Chase / SMS (METH Stage 8) ---------------------------------------------
# demo = DemoSmsSender writes the SMS outbox rows the outbox screen reads — no
# Twilio, ever, in this push (the only value until Twilio Messaging lands).
SMS_SENDER=demo
# Signs the chase portal-link token (Stage 8 mints it, Stage 9's OTP portal
# verifies it). Local-only value; generate a real one with: openssl rand -hex 32.
# Empty fails closed — an empty secret cannot mint or accept a forgeable link.
PORTAL_LINK_SECRET=dev-only-change-me-2222222222222222222222222222222222222222222222

# --- OTP portal (METH Stage 9) ----------------------------------------------
# Signs the portal SESSION bearer returned by POST /v1/portal/sessions and sent
# as `Authorization: Bearer …` on /v1/portal/context and /v1/portal/uploads.
# A SECOND secret on purpose: the link above is a 24 h public URL, this is a
# short-lived credential that has already passed the OTP — rotating one must not
# be forced to invalidate the other. Empty fails closed.
PORTAL_SESSION_SECRET=dev-only-change-me-3333333333333333333333333333333333333333333333
# The OTP itself is verified by OTP_MODE (see --- Auth --- above): `demo` accepts
# the fixed code 000000 and nothing else, until Twilio Verify lands.

# --- Publishing to the ledger (METH Stage 10) -------------------------------
# demo = DemoXeroAdapter: deterministic XERO-INV-#### references, a simulated
#        per-item delay, and one scripted failure that succeeds on retry. No
#        socket is opened, so the XERO_* sandbox keys below stay blank.
# The only value today, and the default — a real bill posting into a real
# client's books must never be the consequence of an unset variable.
LEDGER_ADAPTER=demo

# --- The AI workspace (Governance §9) ---------------------------------------
# bedrock = the real model. Amazon Bedrock, eu-west-2, IAM — no key goes here.
#           On ECS that is the task role; on a laptop it is whatever the AWS
#           default credential chain finds (`aws sso login`, a profile, env
#           vars). The principal needs bedrock:InvokeModel on the foundation
#           models pinned in modules/chat-framework/models.ts, in eu-west-2.
# demo    = a deterministic offline stand-in. Unit tests never open a socket
#           and a laptop with no AWS credentials still runs.
#
# Default `demo` so a cold clone works. REFUSED under NODE_ENV=production:
# every other demo switch degrades something you can see (no SMS arrives, no
# bill reaches Xero), but a stand-in classifier looks exactly as authoritative
# as the real one on screen.
#
# ⚠ Set AI_CHAT=bedrock for the chat beats to use the real model. With `demo`
# the assistant still answers — it just answers from a crude keyword table.
AI_CHAT=demo

# Pinned by D30 / ADR 0001 (UK residency). Model IDs are region-scoped and the
# task role holds no cross-region inference profile, so this is not a knob to
# turn casually — changing it is a residency decision.
BEDROCK_REGION=eu-west-2

# Per-practice daily AI ceiling, integer pence (§9.7). Warn at 80%, hard stop
# at 100% with a plain message. £5/day is demo-scale: noticeable, not punitive.
AI_DAILY_BUDGET_PENCE=2500

# --- Third-party sandboxes (Guideline §8.4 — sandbox keys only, never prod) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

COMPANIES_HOUSE_API_KEY=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# --- WhatsApp / Meta Cloud API (inbound webhook) ----------------------------
# META_APP_SECRET keys the POST HMAC (X-Hub-Signature-256); META_VERIFY_TOKEN is
# the shared string for Meta's GET handshake — two DIFFERENT secrets. Sandbox
# credentials are not issued yet, so the webhook fails closed (POST 401 / GET
# 403) until these are set. Names per issue #9 (were WHATSAPP_* in the scaffold).
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- WhatsApp media fetch (#79) ---------------------------------------------
# fixture = seeded in-memory bytes, no network (the default; an UNSEEDED id
#           fails rather than inventing a placeholder document).
# graph   = the real Meta Cloud API. Needs META_MEDIA_ACCESS_TOKEN, which is a
#           THIRD secret — a System User bearer with whatsapp_business_messaging.
#           Neither secret above authenticates a Graph call. The process refuses
#           to boot on MEDIA_FETCH=graph with this blank.
MEDIA_FETCH=fixture
META_MEDIA_ACCESS_TOKEN=

# Which practice a WABA number's documents belong to, as JSON — the tenancy
# anchor an unrouted WhatsApp document has instead of a business. INTERIM: it
# lives here because nothing in prisma/ maps a Meta number to a practice yet
# (G7, raised on #79). Unmapped number → the worker refuses to persist and the
# job dead-letters; it is never a quiet success. The seed practice is
# prac_ledgerline, so the demo:whatsapp beat wants (uncomment + set META_APP_SECRET):
# WHATSAPP_PRACTICE_MAP={"123456789012345":"prac_ledgerline"}
WHATSAPP_PRACTICE_MAP={}

# --- Feature flags ----------------------------------------------------------
# file = local flags file behind the Unleash interface (Guideline §8.5).
# Flipping to a real Unleash server at Infra Week must be config only.
FLAGS_MODE=file

# --- Web --------------------------------------------------------------------
# mock  = MSW intercepts everything (default, and what Vercel previews use)
# local = talk to the NestJS API on localhost
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Billing / Stripe (D48, launch stage S4) --------------------------------
# demo   = DemoStripeClient, the default. Mints hosted-session URLs on the
#          reserved `.invalid` TLD, so a demo checkout link provably cannot
#          resolve to a payment page. Entitlement is still enforced from the
#          database — `demo` does not mean "everything is free".
# stripe = the real hosted Checkout and customer portal. Refuses to boot
#          without the four values below (see docs/runbooks/stripe-billing.md).
BILLING=demo

# Prefer a RESTRICTED key (rk_...) over a secret key (sk_...): this integration
# writes customers, checkout sessions and portal sessions and reads nothing
# else. Never commit a real value here — deployed environments read it from
# Secrets Manager, not from a file.
STRIPE_SECRET_KEY=
# Signs POST /v1/webhooks/stripe. Verified against the RAW body before parsing.
# Empty = every event 401s, which is the correct closed state. For local work,
# `stripe listen --forward-to localhost:3000/v1/webhooks/stripe` prints a
# whsec_ for that session — use that one, not the dashboard's.
STRIPE_WEBHOOK_SECRET=
# The ONE price: "Neo Accounting", GBP 8.50/month, tax_behavior=EXCLUSIVE.
STRIPE_PRICE_ID=

# How VAT is added on top of that net price.
# rate      = an explicit 20% GB rate via default_tax_rates (the default).
#             Works with no Stripe Tax registration, which is the situation
#             until the VAT registration number exists.
# automatic = Stripe Tax. WARNING: collects NOTHING, and reports no error,
#             until there is an ACTIVE UK registration in the dashboard.
STRIPE_TAX=rate
STRIPE_TAX_RATE_ID=

# The origins successUrl / cancelUrl / returnUrl may point at, comma separated.
# Those three are caller-supplied on authenticated endpoints, so an unvalidated
# one is an open redirect with a session attached. Empty admits nothing.
BILLING_RETURN_ORIGINS=http://localhost:5173
