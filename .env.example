# Copy to .env — never commit .env (Guideline R2, Governance §11.5).
# The app validates this file with Zod at boot and fails fast on anything
# missing or malformed. No process.env access outside that module.
#
# Every value here points at Docker Compose. Nothing in this file is a real
# credential, and nothing in it should ever become one — production secrets
# live in AWS Secrets Manager.

NODE_ENV=development
TZ=Europe/London

# --- App --------------------------------------------------------------------
# The API binds here. 3000 is pinned by infra/envs/staging (ALB target group +
# app security group open exactly 3000); do not change it without the infra.
PORT=3000

# --- Core services (docker compose up) -------------------------------------
# TWO URLS, AND THE SPLIT IS THE TENANCY GUARANTEE (Governance §5.2, issue #17).
#
# Postgres bypasses row-level security for a superuser and for the owner of a
# table. `neoting` is both. So an application connected as `neoting` sees every
# row of every practice with every policy in prisma/sql/rls.sql still in place
# and still looking correct — the isolation is simply not applied. That is not a
# theoretical risk: it was the state of this repo until 14 Aug 2026, and it means
# a tenancy bug cannot fail on your machine, only in front of a client.
#
#   DATABASE_URL  -> nt_app  : the application. Not owner, not superuser, no
#                              BYPASSRLS, so the policies actually bite.
#   DIRECT_URL    -> neoting : prisma migrate and db:seed ONLY. These legitimately
#                              need to write across every tenant, and they are the
#                              only things that ever should.
#
# Create the role once after `docker compose up`: `pnpm db:app-role`.
DATABASE_URL=postgresql://nt_app:nt_app_local@localhost:5433/neoting?schema=public
DIRECT_URL=postgresql://neoting:neoting@localhost:5433/neoting?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 (MinIO locally) -----------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=neoting
S3_SECRET_ACCESS_KEY=neoting123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=nt-local-docs
S3_BUCKET_RECEIPTS=nt-local-receipts
S3_BUCKET_EXPORTS=nt-local-exports

# --- Email (MailHog locally) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=doc@neoting.neovogent.com
# Inbound email intake source (#78). fixture = in-memory (default, offline);
# mailhog = poll the local SES stand-in's HTTP API; s3 = the SES receipt prefix
# in staging. Run the poller with: pnpm --filter @neoting/api worker:email
EMAIL_SOURCE=fixture
MAILHOG_API_URL=http://localhost:8025

# --- Auth -------------------------------------------------------------------
# Local-only values. Generate real ones with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
OTP_PEPPER=dev-only-change-me-1111111111111111111111111111111111111111111111
# fixture = trust X-NT-* dev headers (default; refused in production).
# session = real signed-cookie sessions (METH Stage 1) — needs SESSION_SECRET.
AUTH_MODE=fixture
# demo = TOTP/OTP verifies against the fixed demo code 000000 (the only mode
# until Twilio Verify lands post-demo).
OTP_MODE=demo

# --- AI (Governance §9.1) ---------------------------------------------------
# fixture  = replay recorded extractions, zero cloud calls. The default, so a
#            fresh clone works offline and lanes stay green if access lags.
# bedrock  = real Bedrock calls, needs AWS creds in the environment.
AI_MODE=fixture
AWS_REGION=eu-west-2
BEDROCK_MODEL_JUDGMENT=anthropic.claude-opus-4-6-v1
BEDROCK_MODEL_WORKHORSE=anthropic.claude-sonnet-4-6
BEDROCK_MODEL_MECHANICAL=amazon.nova-lite-v1:0

# --- Extraction -------------------------------------------------------------
# fixture | textract
EXTRACTION_MODE=fixture

# --- Chase / SMS (METH Stage 8) ---------------------------------------------
# demo = DemoSmsSender writes the SMS outbox rows the outbox screen reads — no
# Twilio, ever, in this push (the only value until Twilio Messaging lands).
SMS_SENDER=demo
# Signs the chase portal-link token (Stage 8 mints it, Stage 9's OTP portal
# verifies it). Local-only value; generate a real one with: openssl rand -hex 32.
# Empty fails closed — an empty secret cannot mint or accept a forgeable link.
PORTAL_LINK_SECRET=dev-only-change-me-2222222222222222222222222222222222222222222222

# --- OTP portal (METH Stage 9) ----------------------------------------------
# Signs the portal SESSION bearer returned by POST /v1/portal/sessions and sent
# as `Authorization: Bearer …` on /v1/portal/context and /v1/portal/uploads.
# A SECOND secret on purpose: the link above is a 24 h public URL, this is a
# short-lived credential that has already passed the OTP — rotating one must not
# be forced to invalidate the other. Empty fails closed.
PORTAL_SESSION_SECRET=dev-only-change-me-3333333333333333333333333333333333333333333333
# The OTP itself is verified by OTP_MODE (see --- Auth --- above): `demo` accepts
# the fixed code 000000 and nothing else, until Twilio Verify lands.

# --- Third-party sandboxes (Guideline §8.4 — sandbox keys only, never prod) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

COMPANIES_HOUSE_API_KEY=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

# --- WhatsApp / Meta Cloud API (inbound webhook) ----------------------------
# META_APP_SECRET keys the POST HMAC (X-Hub-Signature-256); META_VERIFY_TOKEN is
# the shared string for Meta's GET handshake — two DIFFERENT secrets. Sandbox
# credentials are not issued yet, so the webhook fails closed (POST 401 / GET
# 403) until these are set. Names per issue #9 (were WHATSAPP_* in the scaffold).
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- WhatsApp media fetch (#79) ---------------------------------------------
# fixture = seeded in-memory bytes, no network (the default; an UNSEEDED id
#           fails rather than inventing a placeholder document).
# graph   = the real Meta Cloud API. Needs META_MEDIA_ACCESS_TOKEN, which is a
#           THIRD secret — a System User bearer with whatsapp_business_messaging.
#           Neither secret above authenticates a Graph call. The process refuses
#           to boot on MEDIA_FETCH=graph with this blank.
MEDIA_FETCH=fixture
META_MEDIA_ACCESS_TOKEN=

# Which practice a WABA number's documents belong to, as JSON — the tenancy
# anchor an unrouted WhatsApp document has instead of a business. INTERIM: it
# lives here because nothing in prisma/ maps a Meta number to a practice yet
# (G7, raised on #79). Unmapped number → the worker refuses to persist and the
# job dead-letters; it is never a quiet success. e.g.
# WHATSAPP_PRACTICE_MAP={"123456789012345":"prac_demo"}
WHATSAPP_PRACTICE_MAP={}

# --- Feature flags ----------------------------------------------------------
# file = local flags file behind the Unleash interface (Guideline §8.5).
# Flipping to a real Unleash server at Infra Week must be config only.
FLAGS_MODE=file

# --- Web --------------------------------------------------------------------
# mock  = MSW intercepts everything (default, and what Vercel previews use)
# local = talk to the NestJS API on localhost
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001
