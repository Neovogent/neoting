# Copy to .env — never commit .env (Guideline R2, Governance §11.5).
# The app validates this file with Zod at boot and fails fast on anything
# missing or malformed. No process.env access outside that module.
#
# Every value here points at Docker Compose. Nothing in this file is a real
# credential, and nothing in it should ever become one — production secrets
# live in AWS Secrets Manager.

NODE_ENV=development
TZ=Europe/London

# --- Core services (docker compose up) -------------------------------------
DATABASE_URL=postgresql://neoting:neoting@localhost:5433/neoting?schema=public
REDIS_URL=redis://localhost:6379

# --- S3 (MinIO locally) -----------------------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-2
S3_ACCESS_KEY_ID=neoting
S3_SECRET_ACCESS_KEY=neoting123
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DOCUMENTS=nt-local-docs
S3_BUCKET_RECEIPTS=nt-local-receipts
S3_BUCKET_EXPORTS=nt-local-exports

# --- Email (MailHog locally) ------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=doc@neoting.neovogent.com

# --- Auth -------------------------------------------------------------------
# Local-only values. Generate real ones with: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me-0000000000000000000000000000000000000000000000
OTP_PEPPER=dev-only-change-me-1111111111111111111111111111111111111111111111

# --- AI (Governance §9.1) ---------------------------------------------------
# fixture  = replay recorded extractions, zero cloud calls. The default, so a
#            fresh clone works offline and lanes stay green if access lags.
# bedrock  = real Bedrock calls, needs AWS creds in the environment.
AI_MODE=fixture
AWS_REGION=eu-west-2
BEDROCK_MODEL_JUDGMENT=anthropic.claude-opus-4-6-v1
BEDROCK_MODEL_WORKHORSE=anthropic.claude-sonnet-4-6
BEDROCK_MODEL_MECHANICAL=amazon.nova-lite-v1:0

# --- Extraction -------------------------------------------------------------
# fixture | textract
EXTRACTION_MODE=fixture

# --- Third-party sandboxes (Guideline §8.4 — sandbox keys only, never prod) --
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_MESSAGING_SERVICE_SID=

XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

INTUIT_CLIENT_ID=
INTUIT_CLIENT_SECRET=

TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=

COMPANIES_HOUSE_API_KEY=
HMRC_CLIENT_ID=
HMRC_CLIENT_SECRET=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Feature flags ----------------------------------------------------------
# file = local flags file behind the Unleash interface (Guideline §8.5).
# Flipping to a real Unleash server at Infra Week must be config only.
FLAGS_MODE=file

# --- Web --------------------------------------------------------------------
# mock  = MSW intercepts everything (default, and what Vercel previews use)
# local = talk to the NestJS API on localhost
NEXT_PUBLIC_API_MODE=mock
NEXT_PUBLIC_API_URL=http://localhost:3001
